extends SceneTree
## Writes docs/REBOUND_LAB_RESULTS.md: every protocol x every length, default settings.
func _initialize():
	var cols := [["Line m","length","%.0f"],["Sag m","static_sag","%.2f"],["Depth m","max_depth","%.2f"],["Peak T kN","peak_tension","kN"],["Leg peak BW","peak_leg_force_bw","%.2f"],["Freq Hz","freq_hz","%.2f"],["Loss %/cycle","energy_loss_pct","%.1f"],["Rebound m/s","rebound_v","%.2f"],["Takeoff m/s","takeoff_v","%.2f"],["Jump m","jump_height","%.2f"],["Air s","airtime","%.2f"],["Takeoffs","takeoffs","%d"],["Landing BW","landing_peak_force_bw","%.2f"]]
	var md := "# Rebound Lab - measured results\n\nGenerated by `tests/lab_report.gd` (deterministic; rerun to reproduce).\n"
	md += "Defaults: 2\" trickline webbing, pretension 3.0 kN, EA 90 kN, 90 g/m, line damping 0.003 s, anchors 3.5 m (same for every length), athlete 75 kg, leg 30 kN/m, max push 3.5 BW. '-' = not reached/not applicable.\n\n"
	for proto in ReboundExperiment.PROTOCOLS:
		md += "## %s\n%s\n\n|" % [proto, ReboundExperiment.PROTOCOLS[proto]]
		for c in cols: md += " %s |" % c[0]
		md += "\n|" + "---|".repeat(cols.size()) + "\n"
		for L in [15.0, 18.0, 20.0, 25.0, 30.0]:
			var e := ReboundExperiment.new(); e.length = L; e.protocol = proto; e.duration = 8.0 if proto == "drop" else 16.0
			var r := e.run()
			md += "|"
			for c in cols:
				var v = r.get(c[1], NAN)
				var cell := "-"
				if not (v is float and is_nan(v)):
					cell = ("%.2f" % (v / 1000.0)) if c[2] == "kN" else (("%d" % int(v)) if c[2] == "%d" else c[2] % v)
				md += " %s |" % cell
			md += "\n"
		md += "\n"
	var f := FileAccess.open("res://docs/REBOUND_LAB_RESULTS.md", FileAccess.WRITE)
	f.store_string(md); f.close()
	print(md)
	quit()
